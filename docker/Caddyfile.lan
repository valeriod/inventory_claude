# Home network without Tailscale: HTTPS with Caddy's own certificate authority.
#   SITE_ADDRESS=inventory.lan   (or the server's LAN IP, e.g. 192.168.1.20)
# Phones must trust Caddy's root certificate once; see docs/DEPLOY.md.
{$SITE_ADDRESS} {
	tls internal
	encode zstd gzip
	reverse_proxy app:3000
}
