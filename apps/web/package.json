{
	"name": "web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit -p src/service-worker/tsconfig.json",
		"test": "vitest run",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@inventory/shared": "workspace:*",
		"zxing-wasm": "^3.1.7"
	},
	"devDependencies": {
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/qrcode": "^1.5.6",
		"fake-indexeddb": "^6.2.8",
		"qrcode": "^1.5.4",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"vite": "^8.3.8",
		"vite-plugin-mkcert": "^2.1.0",
		"vitest": "^5.1.1"
	}
