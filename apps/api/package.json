{
	"name": "api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
		"build": "node scripts/build.mjs",
		"start": "STATIC_DIR=${STATIC_DIR:-../web/build} node --env-file-if-exists=../../.env dist/server.js",
		"db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
		"db:seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.11",
		"@inventory/db": "workspace:*",
		"@inventory/shared": "workspace:*",
		"better-sqlite3": "13.2.0",
		"hono": "^4.13.19",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.15",
		"vitest": "^5.1.1"
	}
}
