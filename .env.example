# Database: SQLite file (default) or Postgres
DATABASE_URL=sqlite://./data/inventory.db
# DATABASE_URL=postgres://inventory:inventory@localhost:5432/inventory

# Bind address. Binding to anything other than localhost requires APP_PASSWORD
# (or ALLOW_NO_AUTH=true, e.g. behind Tailscale/VPN).
HOST=127.0.0.1
PORT=3000

# Single-user password protection: shows a login screen and protects the API
# APP_PASSWORD=
# SESSION_SECRET=   # 32+ random characters, required when APP_PASSWORD is set
# ALLOW_NO_AUTH=false

# Base URL encoded into printed QR labels
PUBLIC_URL=http://localhost:5173

# Behind a reverse proxy (Caddy, tailscale serve): use X-Forwarded-For for the login rate limit
# TRUST_PROXY=false

# Nightly backups (the Docker image sets BACKUP_DIR=/data/backups)
# BACKUP_DIR=./data/backups
# BACKUP_KEEP=14
# BACKUP_HOUR=3

# ---- Docker Compose (docs/DEPLOY.md) ----
# HTTPS with docker/compose.caddy.yml
# CADDYFILE=Caddyfile.public      # or Caddyfile.lan
# SITE_ADDRESS=inventory.example.com
# ACME_EMAIL=you@example.com
# Postgres with docker/compose.postgres.yml
# POSTGRES_PASSWORD=
